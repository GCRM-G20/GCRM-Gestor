// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id             String   @id @default(cuid())
  name           String
  username       String   @default("")
  email          String   @unique
  password        String
  role           String   @default("user")
  licencia       String   @default("") // promotor, coordinador, senior, supervisor
  paymentHash    String   @default("") // hash de pago USDT
  tradingPackage String   @default("") // 2000 GCRM, 4000 GCRM, 8000 GCRM, 16000 GCRM
  usdtWallet     String   @default("") // billetera USDT del miembro para recibir comisiones
  usdtNetwork    String   @default("") // red de la billetera: bep20, trx, sol
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  referrals Referral[]
}

model Referral {
  id             String   @id @default(cuid())
  userId         String
  referredName   String
  referredEmail  String
  commission     Float    @default(0)
  status         String   @default("pending") // pending, confirmed, paid
  depositAmount  Float?
  depositNetwork String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}